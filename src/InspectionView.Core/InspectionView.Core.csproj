<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 검사 프로그램(런타임) 연동을 위해 net48 + net8.0 멀티타겟 -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <AssemblyName>InspectionView.Core</AssemblyName>
    <RootNamespace>InspectionView.Core</RootNamespace>
    <Description>InspectionView core: iconic types (Image/Region/XLD/Tuple/ObjectArray), operator registry, backends.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

</Project>
