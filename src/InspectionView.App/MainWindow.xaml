<Window x:Class="InspectionView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:vm="clr-namespace:InspectionView.App.ViewModels"
        xmlns:viewer="clr-namespace:InspectionView.App.Viewer"
        xmlns:nodes="clr-namespace:InspectionView.App.Nodes"
        xmlns:rt="clr-namespace:InspectionView.Runtime;assembly=InspectionView.Runtime"
        x:Name="Root"
        Title="{Binding Title}" Height="860" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand, ElementName=Root}" />
        <KeyBinding Key="F6" Command="{Binding StepCommand, ElementName=Root}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand, ElementName=Root}" />
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand, ElementName=Root}" />
        <KeyBinding Key="F2" Command="{Binding ResetCommand, ElementName=Root}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand, ElementName=Root}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand, ElementName=Root}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand, ElementName=Root}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand, ElementName=Root}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- 메뉴 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand, ElementName=Root}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand, ElementName=Root}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand, ElementName=Root}" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand, ElementName=Root}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Job">
                <MenuItem Header="_New Job" Click="OnNewJob" />
                <MenuItem Header="_Open Job..." Click="OnOpenJob" />
                <MenuItem Header="_Save Job" Click="OnSaveJob" />
                <MenuItem Header="Save Job _As..." Click="OnSaveJobAs" />
                <Separator />
                <MenuItem Header="_Test Run Job" Click="OnTestRunJob" ToolTip="Run the job through the runtime using current variables as inputs" />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_New Graphics Window" Click="OnNewGraphicsWindow" />
                <MenuItem Header="_Close Extra Graphics Windows" Click="OnCloseExtraGraphicsWindows" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run" InputGestureText="F5" Command="{Binding RunCommand, ElementName=Root}" />
                <MenuItem Header="_Step" InputGestureText="F6" Command="{Binding StepCommand, ElementName=Root}" />
                <MenuItem Header="S_top" InputGestureText="Shift+F5" Command="{Binding StopCommand, ElementName=Root}" />
                <MenuItem Header="R_eset" InputGestureText="F2" Command="{Binding ResetCommand, ElementName=Root}" />
                <Separator />
                <MenuItem Header="Toggle _Breakpoint" InputGestureText="F9" Command="{Binding ToggleBreakpointCommand, ElementName=Root}" />
                <MenuItem Header="Set _Next Statement" Command="{Binding SetNextStatementCommand, ElementName=Root}" />
                <MenuItem Header="Clear All Breakpoints" Click="OnClearBreakpoints" />
                <Separator />
                <MenuItem Header="Clear _Variables" Click="OnClearVariables" />
                <MenuItem Header="Auto Display Results" IsCheckable="True" IsChecked="{Binding AutoDisplay}" ToolTip="Show the last image / region result in the graphics window whenever execution pauses" />
                <MenuItem Header="Fast Mode (no display update)" IsCheckable="True" IsChecked="{Binding FastMode}" />
            </MenuItem>
        </Menu>

        <!-- 툴바 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding NewCommand, ElementName=Root}" ToolTip="New (Ctrl+N)">New</Button>
                <Button Command="{Binding OpenCommand, ElementName=Root}" ToolTip="Open (Ctrl+O)">Open</Button>
                <Button Command="{Binding SaveCommand, ElementName=Root}" ToolTip="Save (Ctrl+S)">Save</Button>
                <Separator />
                <Button Command="{Binding RunCommand, ElementName=Root}" ToolTip="Run (F5)" FontWeight="Bold" Foreground="DarkGreen">▶ Run</Button>
                <Button Command="{Binding StepCommand, ElementName=Root}" ToolTip="Step (F6)">⤵ Step</Button>
                <Button Command="{Binding StopCommand, ElementName=Root}" ToolTip="Stop (Shift+F5)" Foreground="DarkRed">■ Stop</Button>
                <Button Command="{Binding ResetCommand, ElementName=Root}" ToolTip="Reset: first line, clear variables and graphics (F2)">⟲ Reset</Button>
                <Separator />
                <TextBlock VerticalAlignment="Center" Margin="4,0">Backend:</TextBlock>
                <ComboBox Width="90" ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" />
                <CheckBox VerticalAlignment="Center" Margin="8,0" IsChecked="{Binding FastMode}" ToolTip="Skip line / variable updates and profiling while running">Fast mode</CheckBox>
            </ToolBar>
        </ToolBarTray>

        <!-- 상태바 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StateText}" FontWeight="Bold" MinWidth="70" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CaretText" Text="Ln 1, Col 1" MinWidth="90" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding GpuText}" Margin="0,0,8,0" />
            </StatusBarItem>
        </StatusBar>

        <!-- 도킹 레이아웃 -->
        <ad:DockingManager x:Name="Dock">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Vertical">
                    <ad:LayoutPanel Orientation="Horizontal">

                        <!-- 왼쪽: 연산자 트리 / Job 터미널 -->
                        <ad:LayoutAnchorablePane DockWidth="250">
                            <ad:LayoutAnchorable Title="Job" ContentId="job" CanClose="False" CanHide="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Name" FontWeight="Bold" />
                                        <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                                        <TextBlock Text="Description" FontWeight="Bold" />
                                        <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" AcceptsReturn="True" MinHeight="40" />

                                        <TextBlock Text="Inputs (variables set by the inspection program)" FontWeight="Bold" />
                                        <DataGrid ItemsSource="{Binding JobInputs}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                                  HeadersVisibility="Column" MinHeight="80" Margin="0,2,0,6" RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" />
                                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" ItemsSource="{x:Static rt:TerminalType.All}" Width="80" />
                                                <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="70" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="Outputs (variables read by the inspection program)" FontWeight="Bold" />
                                        <DataGrid ItemsSource="{Binding JobOutputs}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                                  HeadersVisibility="Column" MinHeight="80" Margin="0,2,0,6" RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" />
                                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" ItemsSource="{x:Static rt:TerminalType.All}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="Resources stored in the package (ROI, models, parameters)" FontWeight="Bold" />
                                        <ListView x:Name="JobResourceList" ItemsSource="{Binding JobResources}" MinHeight="60" Margin="0,2,0,2">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Name" Width="90" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding Type}" />
                                                    <GridViewColumn Header="Value" Width="200" DisplayMemberBinding="{Binding Summary}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="OnAddJobResource" Padding="6,1" Margin="0,0,4,0" ToolTip="Store the variable selected in the Variables window">Add selected variable</Button>
                                            <Button Click="OnRemoveJobResource" Padding="6,1">Remove</Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable Title="Camera" ContentId="camera" CanClose="False" CanHide="False">
                                <DockPanel DataContext="{Binding Camera}" Margin="4">
                                    <StackPanel DockPanel.Dock="Top">
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Provider" Width="60" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Padding="6,1" Click="OnCameraRefresh" ToolTip="Re-enumerate providers and devices">Refresh</Button>
                                            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" IsEnabled="{Binding IsClosed}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Device" Width="60" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding Devices}" Text="{Binding Device, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding IsClosed}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Options" Width="60" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsClosed}" ToolTip="Key=Value;Key2=Value2" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,4" />
                                        <WrapPanel Margin="0,2">
                                            <Button Padding="8,1" Margin="0,0,4,2" Click="OnCameraOpen" IsEnabled="{Binding IsClosed}">Open</Button>
                                            <Button Padding="8,1" Margin="0,0,4,2" Click="OnCameraClose" IsEnabled="{Binding IsOpen}">Close</Button>
                                            <Button Padding="8,1" Margin="0,0,4,2" Click="OnCameraSnap" IsEnabled="{Binding IsOpen}" ToolTip="Grab one frame into the variable">Snap</Button>
                                            <ToggleButton Padding="8,1" Margin="0,0,4,2" IsChecked="{Binding Live}" IsEnabled="{Binding IsOpen}" ToolTip="Continuous acquisition into the active graphics window">Live</ToggleButton>
                                        </WrapPanel>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Image var" Width="60" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Handle var" Width="60" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Padding="6,1" Click="OnCameraBind" IsEnabled="{Binding IsOpen}" ToolTip="Expose the open camera to the script as this variable (GrabImage(Cam))">Bind</Button>
                                            <TextBox Text="{Binding HandleName, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <TextBlock Text="Parameters" FontWeight="Bold" Margin="0,6,0,2" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding Parameters}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="0" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="110" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="ToolTip" Value="{Binding Description}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="Gray" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <!-- 선택형(Enum/Boolean, 쓰기 가능)은 콤보박스로 바로 선택, 그 외는 범위 표시 -->
                                            <DataGridTemplateColumn Header="Range / Select" Width="110" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Range}" ToolTip="{Binding Range}" VerticalAlignment="Center"
                                                                       Visibility="{Binding ShowRangeText, Converter={StaticResource BoolToVisibility}}" />
                                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=OneWay}" FontSize="11" Padding="2,0"
                                                                      SelectionChanged="OnCameraChoiceChanged"
                                                                      Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable Title="Operators" ContentId="operators" CanClose="False" CanHide="False">
                                <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                                    <ToggleButton IsChecked="{Binding OperatorsAlphabetical}" Padding="6,0" ToolTip="Show all operators sorted by name instead of by category">A-Z</ToggleButton>
                                    <TextBlock Text="Type letters to jump" Foreground="Gray" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
                                </StackPanel>
                                <TreeView x:Name="OperatorTreeView" ItemsSource="{Binding OperatorTree}"
                                          MouseDoubleClick="OnOperatorDoubleClick" PreviewTextInput="OnOperatorTextInput" BorderThickness="0">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:OperatorNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding ToolTip}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <EventSetter Event="Selected" Handler="OnOperatorItemSelected" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <!-- 가운데: 에디터 -->
                        <ad:LayoutDocumentPane>
                            <ad:LayoutDocument Title="Script" ContentId="script" CanClose="False">
                                <avalonedit:TextEditor x:Name="Editor"
                                                       FontFamily="Consolas" FontSize="13"
                                                       ShowLineNumbers="True"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto">
                                    <avalonedit:TextEditor.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Run (F5)" Command="{Binding RunCommand, ElementName=Root}" />
                                            <MenuItem Header="Step (F6)" Command="{Binding StepCommand, ElementName=Root}" />
                                            <MenuItem Header="Toggle Breakpoint (F9)" Command="{Binding ToggleBreakpointCommand, ElementName=Root}" />
                                            <MenuItem Header="Set Next Statement" Command="{Binding SetNextStatementCommand, ElementName=Root}" />
                                            <Separator />
                                            <MenuItem Header="Cut" Command="ApplicationCommands.Cut" />
                                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                                            <MenuItem Header="Paste" Command="ApplicationCommands.Paste" />
                                        </ContextMenu>
                                    </avalonedit:TextEditor.ContextMenu>
                                </avalonedit:TextEditor>
                            </ad:LayoutDocument>
                            <ad:LayoutDocument x:Name="NodesDocument" Title="Nodes" ContentId="nodes" CanClose="False">
                                <nodes:NodeEditorView x:Name="NodeEditor" DataContext="{Binding NodeGraph}" />
                            </ad:LayoutDocument>
                        </ad:LayoutDocumentPane>

                        <!-- 오른쪽: 변수창 + 미리보기 -->
                        <ad:LayoutPanel Orientation="Vertical" DockWidth="520">
                            <ad:LayoutAnchorablePane DockHeight="300">
                                <ad:LayoutAnchorable Title="Variables" ContentId="variables" CanClose="False" CanHide="False">
                                    <ListView ItemsSource="{Binding Variables}" SelectedItem="{Binding SelectedVariable}" BorderThickness="0" MouseDoubleClick="OnVariableDoubleClick">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="" Width="52">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Width="44" Height="34" Background="#FF303030">
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="1" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Name" Width="110" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}" />
                                                <GridViewColumn Header="Value" Width="400" DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </ad:LayoutAnchorable>
                            </ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorablePane x:Name="GraphicsPane">
                                <ad:LayoutAnchorable Title="Graphics 1" ContentId="graphics1" CanClose="False" CanHide="False">
                                    <viewer:ImageViewer x:Name="Viewer" />
                                </ad:LayoutAnchorable>
                            </ad:LayoutAnchorablePane>
                        </ad:LayoutPanel>
                    </ad:LayoutPanel>

                    <!-- 아래: 출력 / 오류 / 프로파일 -->
                    <ad:LayoutAnchorablePane DockHeight="200">
                        <ad:LayoutAnchorable Title="Output" ContentId="output" CanClose="False" CanHide="False">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Padding="8,1" Margin="2" Click="OnClearOutput">Clear</Button>
                                <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                         TextChanged="OnOutputChanged" />
                            </DockPanel>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable Title="Errors" ContentId="errors" CanClose="False" CanHide="False">
                            <ListView ItemsSource="{Binding Diagnostics}" MouseDoubleClick="OnDiagnosticDoubleClick" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Kind" Width="70" DisplayMemberBinding="{Binding Severity}" />
                                        <GridViewColumn Header="Line" Width="50" DisplayMemberBinding="{Binding Line}" />
                                        <GridViewColumn Header="Col" Width="40" DisplayMemberBinding="{Binding Column}" />
                                        <GridViewColumn Header="Message" Width="900" DisplayMemberBinding="{Binding Message}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable Title="Histogram" ContentId="histogram" CanClose="False" CanHide="False">
                            <viewer:HistogramControl x:Name="Histogram" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable Title="Line Profile" ContentId="lineprofile" CanClose="False" CanHide="False">
                            <viewer:ProfileControl x:Name="LineProfile" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable Title="Timing" ContentId="timing" CanClose="False" CanHide="False">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Padding="8,1" Margin="2" Click="OnClearProfile">Clear</Button>
                                <ListView ItemsSource="{Binding Profile}" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}" />
                                            <GridViewColumn Header="Line" Width="45" DisplayMemberBinding="{Binding Line}" />
                                            <GridViewColumn Header="Operator" Width="140" DisplayMemberBinding="{Binding Operator}" />
                                            <GridViewColumn Header="Backend" Width="160" DisplayMemberBinding="{Binding Backend}" />
                                            <GridViewColumn Header="Time (ms)" Width="90" DisplayMemberBinding="{Binding Milliseconds, StringFormat={}{0:F3}}" />
                                            <GridViewColumn Header="Result" Width="120" DisplayMemberBinding="{Binding Result}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
