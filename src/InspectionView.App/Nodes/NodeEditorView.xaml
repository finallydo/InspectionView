<UserControl x:Class="InspectionView.App.Nodes.NodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:local="clr-namespace:InspectionView.App.Nodes"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="OnFromScript" ToolTip="Rebuild the graph from the script editor text">From Script</Button>
            <Button Click="OnToScript" ToolTip="Replace the script editor text with this graph">To Script</Button>
            <Button Click="OnRun" ToolTip="Write the graph to the script and run it (F5)">Run</Button>
            <Separator />
            <Button Click="OnAutoLayout">Auto Layout</Button>
            <Button Click="OnDelete" ToolTip="Delete selected nodes (Del)">Delete</Button>
            <Separator />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="6,0" />
            <TextBlock Text="(unsaved changes)" Foreground="DarkOrange" VerticalAlignment="Center"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
        </ToolBar>

        <nodify:NodifyEditor x:Name="EditorControl"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             PendingConnection="{Binding PendingConnection}"
                             Background="#FF1E1E1E">
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                    <Setter Property="Location" Value="{Binding Location}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected}" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type local:NodeVm}">
                    <nodify:Node Header="{Binding Title}" ToolTip="{Binding ToolTip}"
                                 Input="{Binding Inputs}" Output="{Binding Outputs}"
                                 Footer="{Binding TimeText}">
                        <!-- 실행 상태: 지금 줄 = 주황 머리 + 노란 테두리, 오류 = 빨간 머리 + 테두리 -->
                        <nodify:Node.Style>
                            <Style TargetType="{x:Type nodify:Node}" BasedOn="{StaticResource {x:Type nodify:Node}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="HeaderBrush" Value="#FFB86E00" />
                                        <Setter Property="BorderBrush" Value="#FFFFD54F" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="HeaderBrush" Value="#FFB00020" />
                                        <Setter Property="BorderBrush" Value="#FFFF5252" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </nodify:Node.Style>
                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type local:ConnectorVm}">
                                <nodify:NodeInput Header="{Binding Title}"
                                                  IsConnected="{Binding IsConnected}"
                                                  Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>
                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type local:ConnectorVm}">
                                <nodify:NodeOutput Header="{Binding Title}"
                                                   IsConnected="{Binding IsConnected}"
                                                   Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>
                        <!-- 연결되지 않은 비아이코닉 입력의 리터럴 편집 -->
                        <ItemsControl ItemsSource="{Binding Inputs}" Margin="4,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ConnectorVm}">
                                    <DockPanel Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" Width="90" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding Literal, UpdateSourceTrigger=LostFocus}" MinWidth="80" FontSize="11" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate DataType="{x:Type local:ConnectionVm}">
                    <nodify:Connection Source="{Binding Output.Anchor}" Target="{Binding Input.Anchor}"
                                       DisconnectCommand="{Binding DisconnectCommand}" />
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate DataType="{x:Type local:PendingConnectionVm}">
                    <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                              CompletedCommand="{Binding FinishCommand}"
                                              AllowOnlyConnectors="True" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>
        </nodify:NodifyEditor>
    </DockPanel>
</UserControl>
