<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>InspectionView.App</RootNamespace>
    <AssemblyName>InspectionView</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 도킹 / 코드 에디터 (뷰어는 이후 OpenTK GLWpfControl 추가) -->
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <!-- OpenGL 뷰어 (D3DImage 기반이라 Airspace 문제 없음) -->
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.2.3" />
    <!-- 노드 편집기 -->
    <PackageReference Include="Nodify" Version="6.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InspectionView.Core\InspectionView.Core.csproj" />
    <ProjectReference Include="..\InspectionView.Script\InspectionView.Script.csproj" />
    <ProjectReference Include="..\InspectionView.Runtime\InspectionView.Runtime.csproj" />
  </ItemGroup>

  <!-- 카메라 플러그인: 먼저 빌드되도록 참조(어셈블리 참조는 안 함)하고 출력 폴더의 Plugins/ 로 복사 -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\InspectionView.Cameras.GenTL\InspectionView.Cameras.GenTL.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\InspectionView.Cameras.FrameGrabbers\InspectionView.Cameras.FrameGrabbers.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="IVCopyPlugins" AfterTargets="Build">
    <!-- 참조한 플러그인 프로젝트의 출력만 복사 (삭제된 플러그인 폴더에 남은 옛 bin 은 무시) -->
    <ItemGroup>
      <IVPluginFile Include="..\..\plugins\InspectionView.Cameras.GenTL\bin\x64\$(Configuration)\net8.0\*.dll" />
      <IVPluginFile Include="..\..\plugins\InspectionView.Cameras.FrameGrabbers\bin\x64\$(Configuration)\net8.0\*.dll" />
      <IVPluginFile Remove="@(IVPluginFile)" Condition="'%(Filename)' == 'InspectionView.Core' Or $([System.String]::Copy('%(Filename)').StartsWith('OpenCvSharp'))" />
      <!-- GenTL 로 통합되어 삭제된 벤더 플러그인 (출력 폴더에 남아 있으면 지운다) -->
      <IVStalePlugin Include="$(OutDir)Plugins\InspectionView.Cameras.Pylon.dll;$(OutDir)Plugins\InspectionView.Cameras.Spinnaker.dll;$(OutDir)Plugins\InspectionView.Cameras.Hikrobot.dll;$(OutDir)Plugins\Basler.Pylon.dll;$(OutDir)Plugins\SpinnakerNET_v140.dll;$(OutDir)Plugins\MvCameraControl.Net.dll" />
    </ItemGroup>
    <Delete Files="@(IVStalePlugin)" ContinueOnError="true" />
    <Copy SourceFiles="@(IVPluginFile)" DestinationFolder="$(OutDir)Plugins" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Copied @(IVPluginFile->Count()) plugin file(s) to $(OutDir)Plugins" />
  </Target>

</Project>
