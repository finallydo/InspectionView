             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#FF252525">
        <TextBlock x:Name="Info" DockPanel.Dock="Top" Foreground="#FFDDDDDD" FontFamily="Consolas" Margin="6,3" Text="No image" />
