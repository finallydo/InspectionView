<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InspectionView.Cameras.Hikrobot</RootNamespace>
    <Description>Hikrobot MVS camera provider. Compiled against MvCameraControl.Net only when the MVS SDK is installed (MVCAM_SDK_PATH), otherwise a stub.</Description>
    <!-- MVS 설치 시 환경변수 MVCAM_SDK_PATH 가 설정된다. 다른 위치면 -p:IVMvsAssembly=<경로\MvCameraControl.Net.dll> -->
    <IVMvsDir Condition="'$(IVMvsDir)' == ''">$(MVCAM_SDK_PATH)</IVMvsDir>
    <IVMvsAssembly Condition="'$(IVMvsAssembly)' == '' And '$(IVMvsDir)' != '' And Exists('$(IVMvsDir)\Development\DotNet\win64\MvCameraControl.Net.dll')">$(IVMvsDir)\Development\DotNet\win64\MvCameraControl.Net.dll</IVMvsAssembly>
    <IVMvsAssembly Condition="'$(IVMvsAssembly)' == '' And '$(IVMvsDir)' != '' And Exists('$(IVMvsDir)\Development\DotNet\MvCameraControl.Net.dll')">$(IVMvsDir)\Development\DotNet\MvCameraControl.Net.dll</IVMvsAssembly>
    <IVHasMvs Condition="'$(IVMvsAssembly)' != '' And Exists('$(IVMvsAssembly)')">true</IVHasMvs>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IVHasMvs)' == 'true'">
    <DefineConstants>$(DefineConstants);IV_HAS_MVS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IVHasMvs)' == 'true'">
    <Reference Include="MvCameraControl.Net">
      <HintPath>$(IVMvsAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="IVReportMvs" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="InspectionView.Cameras.Hikrobot: SDK $([MSBuild]::ValueOrDefault('$(IVHasMvs)', 'false')) ($(IVMvsAssembly))" />
  </Target>

</Project>
