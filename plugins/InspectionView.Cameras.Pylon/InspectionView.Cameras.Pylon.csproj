<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InspectionView.Cameras.Pylon</RootNamespace>
    <Description>Basler pylon camera provider. Compiled against the SDK only when it is installed (PYLON_DEV_DIR), otherwise a stub provider reporting 'unavailable'.</Description>
    <!-- pylon 설치 시 환경변수 PYLON_DEV_DIR 가 설정된다. 다른 위치면 msbuild -p:IVPylonAssembly=<경로\Basler.Pylon.dll> -->
    <IVPylonDir Condition="'$(IVPylonDir)' == ''">$(PYLON_DEV_DIR)</IVPylonDir>
    <IVPylonAssembly Condition="'$(IVPylonAssembly)' == '' And '$(IVPylonDir)' != ''">$(IVPylonDir)\Assemblies\Basler.Pylon\x64\Basler.Pylon.dll</IVPylonAssembly>
    <IVHasPylon Condition="'$(IVPylonAssembly)' != '' And Exists('$(IVPylonAssembly)')">true</IVHasPylon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IVHasPylon)' == 'true'">
    <DefineConstants>$(DefineConstants);IV_HAS_PYLON</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IVHasPylon)' == 'true'">
    <Reference Include="Basler.Pylon">
      <HintPath>$(IVPylonAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="IVReportPylon" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="InspectionView.Cameras.Pylon: SDK $([MSBuild]::ValueOrDefault('$(IVHasPylon)', 'false')) ($(IVPylonAssembly))" />
  </Target>

</Project>
